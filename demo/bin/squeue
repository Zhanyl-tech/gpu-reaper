#!/usr/bin/env bash
# Fake squeue for the demo. Emits the same pipe-delimited shape the real
# --Format string produces (Name last), so the parser under test is the
# production one.
#
# Like real squeue, it prints StartTime in local time: it honours TZ, and it
# honours SLURM_TIME_FORMAT when that is set to anything but "standard".
# gpu-reaper forces TZ=UTC and SLURM_TIME_FORMAT=standard for the child, which
# is what makes the output parseable whatever the host's zone is. CI runs the
# demo under several zones to keep that true.
#
# Arguments (--nodelist and friends) are ignored. Start times are whole hours
# before an anchor that stays fixed for the whole run, because a real job's
# StartTime does not move: computing them from "now" on every call would shift
# them each second, and gpu-reaper would rightly treat each shift as a requeue
# and start over. The Makefile and demo/check.sh set FAKE_SQUEUE_ANCHOR to the
# time the run started, so the jobs are hours old, and a time-zone parsing error
# of several hours (e.g. TZ=Asia/Tokyo, UTC+9) makes the 3-hour-old job look
# like it starts in the future, so it is never judged and the check fails. The
# scenario played against the jobs is chosen by the GPU simulator.
set -euo pipefail

fmt='%Y-%m-%dT%H:%M:%S'
if [[ -n "${SLURM_TIME_FORMAT:-}" && "${SLURM_TIME_FORMAT}" != standard ]]; then
	fmt="$SLURM_TIME_FORMAT"
fi

anchor="${FAKE_SQUEUE_ANCHOR:-1767225600}" # default: 2026-01-01T00:00:00Z

started() {
	local epoch=$(( anchor - $1 * 3600 ))
	date -d "@$epoch" +"$fmt" 2>/dev/null || date -r "$epoch" +"$fmt"
}

cat <<OUT
100241|alice|research|gpu|normal|RUNNING|$(started 6)|gpu[001-002]|cpu=64,mem=512G,node=2,billing=64,gres/gpu=16|llama-70b-sft
100242|bob|infra|gpu|normal|RUNNING|$(started 3)|gpu003|cpu=16,mem=128G,node=1,gres/gpu=4|dataprep
100243|carol|research|gpu|high|RUNNING|$(started 9)|gpu004|cpu=8,mem=64G,node=1,gres/gpu=2|eval-sweep
100244|dave|infra|cpu|normal|RUNNING|$(started 2)|cpu001|cpu=32,mem=64G,node=1|cpu-etl
OUT
